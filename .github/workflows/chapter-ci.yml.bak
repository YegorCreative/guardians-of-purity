name: Chapter CI

on:
  push:
    branches: [ "main" ]
  pull_request:

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Validate chapters
        run: python3 tools/validate_chapters.py

      - name: Generate journey data
        run: python3 tools/generate_journey_data.py

      - name: Audit chapters
        run: python3 tools/audit_chapters.py
